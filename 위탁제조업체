import pandas as pd
import requests
from bs4 import BeautifulSoup
from tqdm import tqdm
import os
import re
from concurrent.futures import ThreadPoolExecutor, as_completed

# --- 설정 구간 ---
USER_NAME = '강해민'  # 본인의 윈도우 사용자 이름 확인
FILE_PATH = f'C:/Users/{USER_NAME}/Desktop/data1.xlsx'
SAVE_PATH = f'C:/Users/{USER_NAME}/Desktop/data1_완료.xlsx'
MAX_WORKERS = 10  # 동시 작업자 10명 (속도 대폭 향상)
# ----------------

def clean_text(text):
    """불필요한 공백 및 태그 제거 후 순수 한국어 텍스트만 추출"""
    if not text: return ""
    text = re.sub(r'<[^>]*>', '', text) # 태그 제거
    text = text.strip().split('\n')[0]  # 첫 줄만 가져오기
    return text

def get_info(item_seq):
    """상세 페이지 접속 및 정보 추출 함수"""
    url = f"https://nedrug.mfds.go.kr/pbp/CCBBB01/getItemDetail?itemSeq={item_seq}"
    try:
        headers = {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'
        }
        # 10개 동시 접속이므로 타임아웃을 15초로 넉넉히 잡습니다.
        response = requests.get(url, headers=headers, timeout=15)
        response.encoding = 'utf-8'
        
        if response.status_code == 200:
            soup = BeautifulSoup(response.text, 'html.parser')
            
            # 1. 실제 등록된 [업체명] 가져오기
            real_entp = ""
            entp_h = soup.find('th', string=re.compile(r'업체명'))
            if entp_h:
                real_entp = clean_text(entp_h.find_next_sibling('td').get_text())
            
            # 2. [위탁제조업체] 가져오기
            consigned_entp = ""
            consigned_h = soup.find('th', string=re.compile(r'위탁제조업체'))
            if consigned_h:
                consigned_entp = clean_text(consigned_h.find_next_sibling('td').get_text())
            
            # 위탁업체가 비어있으면 실제 업체명(한국어) 반환
            final_consigned = consigned_entp if consigned_entp else real_entp
            
            return item_seq, real_entp, final_consigned
    except:
        pass
    return item_seq, None, None

def main():
    if not os.path.exists(FILE_PATH):
        print(f"❌ 바탕화면에서 파일을 찾을 수 없습니다: {FILE_PATH}")
        return

    # 엑셀 로드
    print("📂 엑셀 파일을 읽어오는 중입니다...")
    df = pd.read_excel(FILE_PATH)
    
    if '위탁제조업체' not in df.columns:
        df['위탁제조업체'] = None
    
    # 아직 정보가 없는(미완료) 행들만 골라내기
    target_indices = df[df['위탁제조업체'].isna() | (df['위탁제조업체'] == "")].index.tolist()
    
    print(f"🚀 총 {len(df)}건 중 {len(target_indices)}건의 작업을 시작합니다. (동시 작업자: {MAX_WORKERS}명)")

    # 멀티스레딩(병렬 처리) 시작
    with ThreadPoolExecutor(max_workers=MAX_WORKERS) as executor:
        # 작업 리스트 생성
        futures = {executor.submit(get_info, str(df.at[i, '품목기준코드'])): i for i in target_indices}
        
        done_count = 0
        for future in tqdm(as_completed(futures), total=len(futures)):
            row_idx = futures[future]
            _, new_entp, final_consigned = future.result()
            
            if new_entp:
                df.at[row_idx, '업체명'] = new_entp
                df.at[row_idx, '위탁제조업체'] = final_consigned
            
            # 200건마다 중간 저장 (데이터 유실 방지)
            done_count += 1
            if done_count % 200 == 0:
                df.to_excel(SAVE_PATH, index=False)

    # 최종 결과 저장
    df.to_excel(SAVE_PATH, index=False)
    print(f"✅ 모든 작업 완료! 바탕화면의 'data1_완료.xlsx'를 확인하세요.")

if __name__ == "__main__":
    main()
