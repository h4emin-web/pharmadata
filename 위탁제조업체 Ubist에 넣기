import pandas as pd
from tqdm import tqdm
import os
import re
from difflib import SequenceMatcher

# --- 설정 구간 ---
USER_NAME = '강해민' 
PATH = f'C:/Users/{USER_NAME}/Desktop'
FILE_10 = f'{PATH}/data10.xlsx'
FILE_20 = f'{PATH}/data20.xlsx'
SAVE_PATH = f'{PATH}/data10_최종업데이트.xlsx'

def ultra_normalize(text):
    """모든 용량 숫자와 제품명을 띄어쓰기 없이 단일화"""
    if not isinstance(text, str): return ""
    
    # 1. 괄호 내용 제거 (예: (니세르골린) 삭제)
    text = re.sub(r'\(.*?\)', '', text)
    
    # 2. 단위 통일 (영문/한글 상관없이 모두 mg, g, ml로 통일)
    text = text.lower().replace('밀리그램', 'mg').replace('그램', 'g').replace('밀리리터', 'ml')
    
    # 3. [중요] 모든 공백 제거 (니세 엠 정 -> 니세엠정)
    text = re.sub(r'\s+', '', text)
    
    # 4. 특수문자 제거 (한글, 영어, 숫자만 남김)
    text = re.sub(r'[^a-z0-9가-힣]', '', text)
    
    return text

def extract_only_digits(text):
    """제품명에서 용량 숫자만 추출하여 리스트로 반환 (30mg -> 30)"""
    return re.findall(r'\d+', text)

def main():
    if not os.path.exists(FILE_10) or not os.path.exists(FILE_20):
        print("❌ 파일을 찾을 수 없습니다.")
        return

    print("📂 데이터를 불러오고 있습니다...")
    df10 = pd.read_excel(FILE_10, header=1) 
    df20 = pd.read_excel(FILE_20)

    # 데이터 정돈 (유령 행 제거)
    df10 = df10.dropna(subset=['제품']).reset_index(drop=True)
    df20 = df20.dropna(subset=['제품']).reset_index(drop=True)
    df10.columns = df10.columns.str.strip()
    df20.columns = df20.columns.str.strip()

    if '위탁제조업체' not in df10.columns:
        df10['위탁제조업체'] = None

    print("🔍 전 제품군 용량 및 이름 분석 중...")
    # data20 데이터 미리 정규화
    df20['norm'] = df20['제품'].apply(ultra_normalize)
    df20['digits'] = df20['norm'].apply(extract_only_digits)
    data20_list = df20.to_dict('records')

    print("🚀 모든 용량대(10, 30, 100...) 통합 매칭 시작...")
    for i in tqdm(range(len(df10))):
        name10 = str(df10.at[i, '제품'])
        norm10 = ultra_normalize(name10)
        digits10 = extract_only_digits(norm10)
        seller10 = str(df10.at[i, '판매사']).strip()
        
        if not norm10: continue

        best_match = None
        
        # 매칭 로직 시작
        for row20 in data20_list:
            norm20 = row20['norm']
            digits20 = row20['digits']
            
            # 1단계: 숫자(용량)가 완벽히 일치하는지 확인 (10mg vs 30mg 오답 방지)
            if digits10 != digits20:
                continue
                
            # 2단계: 띄어쓰기와 괄호를 제거한 이름이 서로 포함되거나 일치하는지 확인
            # '니세엠정10mg' == '니세엠정10mg' (괄호 빠진 이름)
            if (norm10 in norm20) or (norm20 in norm10):
                best_match = row20
                break # 찾으면 즉시 중단

        # 결과 업데이트
        if best_match:
            # 위탁제조업체 정보 이관
            df10.at[i, '위탁제조업체'] = best_match.get('위탁제조업체')
            
            # 판매사 업데이트 (data20 기준)
            s20 = str(best_match.get('판매사', '')).strip()
            if s20 and s20 != 'nan':
                df10.at[i, '판매사'] = s20

    print("💾 최종 결과 저장 중...")
    df10.to_excel(SAVE_PATH, index=False)
    print(f"✅ 작업 완료! 저장된 파일: {SAVE_PATH}")

if __name__ == "__main__":
    main()
