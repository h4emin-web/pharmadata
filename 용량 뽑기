import pandas as pd
import re
import os
from tqdm import tqdm

def extract_weight_to_mg(text):
    """텍스트에서 직접적으로 용량을 찾아 mg 단위로 반환"""
    if not isinstance(text, str): return None
    clean_text = text.replace(" ", "").lower()
    
    # 단위 표준화
    clean_text = clean_text.replace("밀리그램", "mg").replace("밀리그람", "mg")
    clean_text = clean_text.replace("그램", "g").replace("그람", "g")
    
    pattern = r'([0-9.]+)(mg|g)'
    matches = re.findall(pattern, clean_text)
    
    if matches:
        val_str, unit = matches[0]
        try:
            val = float(val_str)
            # 환산된 값을 반환하되, 비교를 위해 소수점 정리
            res = val * 1000 if unit == 'g' else val
            return int(res) if res == int(res) else res
        except: return None
    return None

def extract_ingredient_name(text):
    """제품명에서 성분명(괄호 안 우선) 추출"""
    if not isinstance(text, str): return ""
    match = re.search(r'\((.*?)\)', text)
    if match:
        ing = match.group(1)
        return re.sub(r'[0-9.a-z\s]+', '', ing) # 숫자/단위 제거
    return re.sub(r'[^가-힣]', '', text)

def process_excel_safe_inference():
    user_name = os.getlogin()
    file_path = f'C:/Users/{user_name}/Desktop/data10000_최종완성.xlsx'
    save_path = f'C:/Users/{user_name}/Desktop/data10000_용량완성.xlsx'

    if not os.path.exists(file_path):
        print("❌ 파일을 찾을 수 없습니다.")
        return

    print("📂 데이터를 분석 중입니다...")
    df = pd.read_excel(file_path)
    
    if df.shape[1] < 17:
        for i in range(df.shape[1], 17): df[f'Temp_{i}'] = ""

    # 성분별 발견된 모든 용량을 저장하는 사전 (집합 사용으로 중복 제거)
    ing_weight_pool = {}
    
    # --- 1차 패스: 성분별 용량 종류 파악 ---
    print("🧠 성분별 용량 데이터 수집 중...")
    for i in range(len(df)):
        p_name = str(df.iloc[i, 4]) # E열
        weight = extract_weight_to_mg(p_name)
        ing = extract_ingredient_name(p_name)
        
        if weight and ing:
            if ing not in ing_weight_pool:
                ing_weight_pool[ing] = set()
            ing_weight_pool[ing].add(weight)

    # --- 2차 패스: 안전한 경우에만 추론 적용 ---
    print("⚖️ 안전한 용량 추론 시작 (중복 용량 성분 제외)...")
    count_direct = 0
    count_inferred = 0
    count_skipped = 0 # 용량이 여러 개라 건너뛴 경우

    for i in tqdm(range(len(df)), desc="처리 중"):
        p_name = str(df.iloc[i, 4]) # E열
        weight = extract_weight_to_mg(p_name)
        
        if weight:
            df.iloc[i, 16] = weight # 직접 기재된 경우
            count_direct += 1
        else:
            ing = extract_ingredient_name(p_name)
            # 사전에 성분이 있고, 그 성분의 용량 종류가 '딱 1개'인 경우만
            if ing in ing_weight_pool:
                if len(ing_weight_pool[ing]) == 1:
                    df.iloc[i, 16] = list(ing_weight_pool[ing])[0]
                    count_inferred += 1
                else:
                    # 10, 30 등 여러 용량이 존재하면 빈칸으로 유지
                    df.iloc[i, 16] = ""
                    count_skipped += 1
            else:
                df.iloc[i, 16] = ""

    # 열 이름 정리
    cols = list(df.columns)
    cols[16] = "용량(mg)"
    df.columns = cols

    print(f"\n✅ 작업 완료!")
    print(f"   - 직접 기재 확인: {count_direct}건")
    print(f"   - 안전 추론 완료: {count_inferred}건")
    print(f"   - 용량 중복으로 인한 제외: {count_skipped}건")
    
    df.to_excel(save_path, index=False)
    print(f"💾 결과가 저장되었습니다: {save_path}")

if __name__ == "__main__":
    process_excel_safe_inference()
